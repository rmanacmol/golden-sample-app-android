<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        AAPT link-time stub for contacts-journey 8.x on MDS 9 (2026.03-LTS).

        contacts-journey layouts (rcj_contact_state_view.xml) reference
        app:iconBackground="?stateViewIconBackground". MDS 9 does not export this
        attribute name for resource merging, so the app must declare the name here
        for :app:processDebugResources to succeed.

        This declares the attribute name only — not a color override. The runtime
        value is set in themes.xml from Theme.Backbase / design-system tokens.

        Not needed on main: main does not bundle contacts-journey. Safe to delete
        once contacts-journey ships layouts compiled against MDS 9 without this attr.
    -->
    <attr name="stateViewIconBackground" format="reference|color" />
</resources>
